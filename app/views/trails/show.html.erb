<div class="space-y-8">
  <!-- Back link -->
  <%= link_to "← Back to Trails", trails_path, class: "text-purple-900 font-bold hover:underline" %>
  
  <!-- Trail header -->
  <div class="bg-gradient-to-r from-cyan-400 to-pink-500 border-4 border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] mt-4">
    <h1 class="text-5xl font-black text-white uppercase drop-shadow-[4px_4px_0px_rgba(0,0,0,1)]">
      <%= @trail.name %>
    </h1>
    <p class="text-lime-300 text-xl font-bold mt-4">
      <%= @trail.description %>
    </p>
    <div class="text-white text-lg mt-4">
      📍 <%= @trail.latitude %>, <%= @trail.longitude %>
    </div>
  </div>

  <!-- Playlists section -->
  <div>
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-3xl font-black text-purple-900 uppercase drop-shadow-[2px_2px_0px_rgba(0,0,0,1)]">
        🎵 Playlists
      </h2>
      <%= link_to "Create Playlist!", new_trail_playlist_path(@trail), class: "px-6 py-3 bg-lime-400 text-purple-900 font-black uppercase border-4 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:scale-105 transition-transform" %>
    </div>

    <% if @playlists.any? %>
      <div class="space-y-6">
        <% @playlists.each do |playlist| %>
          <div class="bg-white border-4 border-black p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex justify-between items-start">
            <div>
              <h3 class="text-2xl font-bold text-purple-900">
                <%= playlist.name %>
              </h3>
              <p class="text-gray-600 mt-2">
                Created by <%= playlist.user.email_address.split('@').first %>
              </p>
            </div>
            
            <% if playlist.user == current_user %>
              <%= button_to "Delete", trail_playlist_path(@trail, playlist), 
                  method: :delete,
                  data: { turbo_confirm: "Are you sure? This will delete the playlist and all its tracks!" },
                  class: "px-4 py-2 bg-red-500 text-white font-bold border-2 border-black hover:bg-red-600" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-yellow-300 border-4 border-black p-8 text-center">
        <p class="text-2xl font-bold text-purple-900">
          No playlists yet... Be the first to create one and radicalize this trail! 🚵‍♂️🎶
        </p>
      </div>
    <% end %>
  </div>
</div>
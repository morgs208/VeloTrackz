<div class="space-y-6 center">
  <h1 class="text-4xl font-black text-purple-900 uppercase drop-shadow-[3px_3px_0px_rgba(0,0,0,1)]">
    🏔️ Mountain Bike Trails
  </h1>

  <div>
    <% @trails.each do |trail| %>
      <%= link_to trail_path(trail), class: "block bg-gradient-to-r from-pink-500 to-cyan-400 border-4 border-black p-6 hover:scale-105 transition-transform shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] rounded-lg mb-12" do %>
        <h2 class="text-2xl font-bold text-white drop-shadow-[2px_2px_0px_rgba(0,0,0,1)]">
          <%= trail.name %>
        </h2>
        <p class="text-lime-300 font-semibold mt-2">
          <%= trail.description %>
        </p>
        <div class="text-white text-sm mt-2">
          📍 <%= trail.latitude %>, <%= trail.longitude %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>